{
	"name": "obsidian-vim-layout-switch",
	"version": "1.0.0",
	"description": "Obsidian plugin: English keyboard layout in Vim normal mode, your own layout (Arabic, etc.) in insert mode.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"vim",
		"arabic",
		"rtl",
		"keyboard-layout",
		"hyprland",
		"sway"
	],
	"author": "BaselCS",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BaselCS/obsidian-vim-layout-switch.git"
	},
	"bugs": {
		"url": "https://github.com/BaselCS/obsidian-vim-layout-switch/issues"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.24.2",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2"
	}
}
